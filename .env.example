# Шаблон переменных окружения.
# Скопируйте в .env и заполните реальными значениями: cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=ticket_bot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ticket_bot

# --- Telegram ---
BOT_TOKEN= # ОБЯЗАТЕЛЕН: токен от @BotFather
BOT_USERNAME= # юзернейм бота без @ — для генерации ссылок утилитой invitegen
BOT_MODE=polling # polling — локально, webhook — на сервере
WEBHOOK_URL= # только для webhook: https://<домен>/telegram/webhook
TELEGRAM_WEBHOOK_SECRET= # только для webhook: X-Telegram-Bot-Api-Secret-Token; openssl rand -hex 16

# --- Вебхук от changedetection.io ---
CHANGEDETECTION_AUTH_TOKEN= # ОБЯЗАТЕЛЕН: заголовок X-Changedetection-Auth; openssl rand -hex 32
NOTIFY_COOLDOWN=0 # 0 (дефолт) — слать каждое изменение: в нише MQ правка и старт продаж разделены секундами. Для шумных страниц вне ниши — например 30m
